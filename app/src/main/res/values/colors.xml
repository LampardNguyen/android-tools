    <color name="md_theme_dark_background">@color/gray_800</color>
    <color name="md_theme_dark_onBackground">@color/base_white</color>
    
    <color name="md_theme_dark_error">@color/semantic_error</color>
    <color name="md_theme_dark_onError">@color/base_white</color>
    <color name="md_theme_dark_errorContainer">@color/semantic_error</color>
    <color name="md_theme_dark_onErrorContainer">#FFF5F5</color>
    
    <color name="md_theme_dark_outline">@color/gray_500</color>
    <color name="md_theme_dark_outlineVariant">@color/gray_600</color>
    <color name="md_theme_dark_scrim">@color/base_black</color>
    <color name="md_theme_dark_shadow">@color/base_black</color>
    
    <!-- Legacy colors for backward compatibility -->
    <color name="black">@color/base_black</color>
    <color name="white">@color/base_white</color>
    
    <!-- Battery Status Colors (Using Quickpay palette) -->
    <color name="battery_critical">@color/semantic_error</color>
    <color name="battery_low">@color/brand_warning</color>
    <color name="battery_good">@color/semantic_success</color>
    <color name="battery_full">@color/brand_primary</color>
    <color name="battery_charging">@color/semantic_success</color>
    
    <!-- Component Specific Colors -->
    <color name="card_background">@color/base_white</color>
    <color name="card_shadow">#14000000</color> <!-- rgba(0,0,0,0.08) -->
    <color name="card_border">@color/gray_100</color>
    
    <!-- Input Field Colors -->
    <color name="input_background_default">@color/gray_50</color>
    <color name="input_background_focus">@color/base_white</color>
    <color name="input_background_error">#FFF5F5</color>
    <color name="input_background_disabled">@color/gray_100</color>
    
    <color name="input_border_default">@color/gray_100</color>
    <color name="input_border_focus">@color/brand_primary</color>
    <color name="input_border_error">@color/semantic_error</color>
    
    <color name="input_text_default">@color/semantic_text_primary</color>
    <color name="input_text_placeholder">@color/gray_300</color>
    <color name="input_text_disabled">@color/gray_300</color>
    
    <!-- Button Colors -->
    <color name="button_primary_background">@color/brand_primary</color>
    <color name="button_primary_background_pressed">#0860CC</color>
    <color name="button_primary_text">@color/base_white</color>
    
    <color name="button_secondary_background">@color/base_white</color>
    <color name="button_secondary_background_pressed">#F0F9FF</color>
    <color name="button_secondary_border">@color/brand_primary</color>
    <color name="button_secondary_text">@color/brand_primary</color>
    
    <color name="button_tertiary_background">@android:color/transparent</color>
    <color name="button_tertiary_background_pressed">#1A108EE9</color> <!-- rgba(16,142,233,0.08) -->
    <color name="button_tertiary_text">@color/brand_primary</color>
    
    <color name="button_disabled_background">@color/gray_200</color>
    <color name="button_disabled_text">@color/gray_300</color>
    
    <!-- Ripple and State Colors -->
    <color name="ripple_primary">#33108EE9</color> <!-- rgba(16,142,233,0.2) -->
    <color name="ripple_secondary">#33000000</color> <!-- rgba(0,0,0,0.2) -->
    
    <!-- Focus and Selection Colors -->
    <color name="focus_ring_primary">#33108EE9</color> <!-- rgba(16,142,233,0.2) -->
    <color name="focus_ring_error">#33F95654</color> <!-- rgba(249,86,84,0.2) -->
    
    <!-- Navigation and Header Colors -->
    <color name="navigation_background">@color/brand_primary</color>
    <color name="navigation_text">@color/base_white</color>
    <color name="navigation_icon">@color/base_white</color>
    
    <!-- Status Bar Colors -->
    <color name="status_bar_background">@android:color/transparent</color>
    <color name="status_bar_icons">@color/base_black</color>
</resources>