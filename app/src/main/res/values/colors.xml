    <color name="md_theme_dark_primary">@color/brand_primary</color>
    <color name="md_theme_dark_onPrimary">@color/base_white</color>
    <color name="md_theme_dark_primaryContainer">@color/brand_primary_dark</color>
    <color name="md_theme_dark_onPrimaryContainer">#E6F7FF</color>
    
    <color name="md_theme_dark_secondary">@color/brand_accent1</color>
    <color name="md_theme_dark_onSecondary">@color/base_white</color>
    <color name="md_theme_dark_secondaryContainer">@color/brand_accent2</color>
    <color name="md_theme_dark_onSecondaryContainer">#FFF3E6</color>
    
    <color name="md_theme_dark_tertiary">@color/semantic_success</color>
    <color name="md_theme_dark_onTertiary">@color/base_white</color>
    <color name="md_theme_dark_tertiaryContainer">@color/semantic_success</color>
    <color name="md_theme_dark_onTertiaryContainer">#E6F7F0</color>
    
    <color name="md_theme_dark_surface">@color/gray_700</color>
    <color name="md_theme_dark_onSurface">@color/base_white</color>
    <color name="md_theme_dark_surfaceVariant">@color/gray_600</color>
