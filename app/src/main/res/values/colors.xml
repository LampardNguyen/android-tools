    <color name="md_theme_light_surfaceVariant">@color/semantic_background_secondary</color>
    <color name="md_theme_light_onSurfaceVariant">@color/semantic_text_secondary</color>
    
    <color name="md_theme_light_background">@color/semantic_background_secondary</color>
    <color name="md_theme_light_onBackground">@color/semantic_text_primary</color>
    
    <color name="md_theme_light_error">@color/semantic_error</color>
    <color name="md_theme_light_onError">@color/base_white</color>
    <color name="md_theme_light_errorContainer">#FFF5F5</color>
    <color name="md_theme_light_onErrorContainer">@color/semantic_error</color>
    
    <color name="md_theme_light_outline">@color/gray_200</color>
    <color name="md_theme_light_outlineVariant">@color/gray_100</color>
    <color name="md_theme_light_scrim">@color/base_black</color>
    <color name="md_theme_light_shadow">@color/base_black</color>
    
    <color name="md_theme_light_inverseSurface">@color/gray_700</color>
    <color name="md_theme_light_inverseOnSurface">@color/base_white</color>
    <color name="md_theme_light_inversePrimary">#E6F7FF</color>
    
