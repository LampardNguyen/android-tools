<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Quickpay Design System Colors for Battery Alert App -->
    
    <!-- Brand Colors -->
    <color name="brand_primary">#108EE9</color>
    <color name="brand_primary_dark">#1677FF</color>
    <color name="brand_primary_light">#4DA3F4</color>
    <color name="brand_accent1">#FD9A16</color>
    <color name="brand_accent2">#EA4E0D</color>
    <color name="brand_warning">#FDD504</color>
    <color name="brand_error">#F95654</color>
    
    <!-- Base Colors -->
    <color name="base_white">#FFFFFF</color>
    <color name="base_black">#242424</color>
    
    <!-- Gray Scale -->
    <color name="gray_50">#F5F7FA</color>
    <color name="gray_100">#E8EBF0</color>
    <color name="gray_200">#D1D5DB</color>
    <color name="gray_300">#9CA3AF</color>
    <color name="gray_400">#6B7280</color>
    <color name="gray_500">#4B5563</color>
    <color name="gray_600">#374151</color>
    <color name="gray_700">#1F2937</color>
    <color name="gray_800">#111827</color>
    
    <!-- Semantic Colors -->
    <color name="semantic_background_primary">#FFFFFF</color>
    <color name="semantic_background_secondary">#F5F7FA</color>
    <color name="semantic_background_tertiary">#E8EBF0</color>
    
    <color name="semantic_text_primary">#242424</color>
    <color name="semantic_text_secondary">#6B7280</color>
    <color name="semantic_text_tertiary">#9CA3AF</color>
    <color name="semantic_text_inverse">#FFFFFF</color>
    <color name="semantic_text_link">#108EE9</color>
    
    <color name="semantic_success">#10B981</color>
    <color name="semantic_info">#108EE9</color>
    <color name="semantic_warning">#FDD504</color>
    <color name="semantic_error">#F95654</color>
    
    <!-- Material Design 3 Theme Colors (Mapped to Quickpay Design System) -->
    <color name="md_theme_light_primary">@color/brand_primary</color>
    <color name="md_theme_light_onPrimary">@color/semantic_text_inverse</color>
    <color name="md_theme_light_primaryContainer">#E6F7FF</color>
    <color name="md_theme_light_onPrimaryContainer">@color/brand_primary_dark</color>
    
    <color name="md_theme_light_secondary">@color/brand_accent1</color>
    <color name="md_theme_light_onSecondary">@color/base_white</color>
    <color name="md_theme_light_secondaryContainer">#FFF3E6</color>
    <color name="md_theme_light_onSecondaryContainer">@color/brand_accent2</color>
    
    <color name="md_theme_light_tertiary">@color/semantic_success</color>
    <color name="md_theme_light_onTertiary">@color/base_white</color>
    <color name="md_theme_light_tertiaryContainer">#E6F7F0</color>
    <color name="md_theme_light_onTertiaryContainer">@color/semantic_success</color>
    
    <color name="md_theme_light_surface">@color/semantic_background_primary</color>
